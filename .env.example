# Public website configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Optional legacy alias if your Supabase client setup uses it
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://graphics.anairapos.in

# Website enquiry email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Anaira Website <website@YOUR_VERIFIED_DOMAIN>

# AI Growth Engine — server-side only; NEVER add NEXT_PUBLIC_ prefix
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook / Instagram / Messenger / Lead Ads
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://graphics.anairapos.in/api/growth/meta/callback
META_GRAPH_API_VERSION=vXX.X
META_WEBHOOK_VERIFY_TOKEN=
META_PIXEL_ID=
META_CONVERSIONS_ACCESS_TOKEN=

# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ORGANIZATION_ID=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://graphics.anairapos.in/api/growth/social-callback/linkedin
LINKEDIN_API_VERSION=

# Google OAuth — YouTube + YouTube Analytics
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://graphics.anairapos.in/api/growth/social-callback/youtube
YOUTUBE_DEFAULT_PRIVACY_STATUS=private

# Media storage / worker / rate limits
GROWTH_MEDIA_BUCKET=growth-media
GROWTH_TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
GROWTH_RATE_LIMIT_SALT=
USD_TO_INR_ESTIMATE=85
