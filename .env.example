# Anaira AI Growth Engine — server environment template
# Copy to .env.local for local development. Never commit real secrets.

# Supabase (server-side service key must NEVER use NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional newer Supabase publishable key; configure only if your project uses it.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public application origin (use the deployed HTTPS origin in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
ANAIRA_GROWTH_SITE_URL=http://localhost:3000

# Growth Engine security / worker
CRON_SECRET=
GROWTH_TOKEN_ENCRYPTION_KEY=
GROWTH_OAUTH_STATE_SECRET=
GROWTH_RATE_LIMIT_SALT=
GROWTH_UNSUBSCRIBE_SECRET=
GROWTH_MEDIA_BUCKET=

# AI (optional if workspace BYOK credentials are configured)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Meta / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_API_VERSION=vXX.X
META_WEBHOOK_VERIFY_TOKEN=
META_PIXEL_ID=
META_CONVERSIONS_ACCESS_TOKEN=
MAX_META_DAILY_BUDGET_MINOR=
MAX_AUTOMATED_BUDGET_CHANGE_PERCENT=

# Google OAuth / Search Console / GA4 / prospect search / Ads
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_ADS_API_VERSION=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202610
LINKEDIN_ORGANIZATION_ANALYTICS_ENABLED=false

# WhatsApp / Twilio voice and SMS
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ORGANIZATION_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TURN_URLS=
WHATSAPP_TURN_SHARED_SECRET=
WHATSAPP_TURN_TTL_SECONDS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_FROM=
VOICE_AGENT_WS_URL=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# Billing
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# Optional provider / display settings
ZEROBOUNCE_API_KEY=
YOUTUBE_DEFAULT_PRIVACY_STATUS=private
USD_TO_INR_ESTIMATE=
