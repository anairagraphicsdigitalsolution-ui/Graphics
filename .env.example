NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications for website enquiries (Resend)
# Create an API key at https://resend.com/api-keys and verify the sender domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Anaira Website <website@your-verified-domain.com>

# AI Growth Engine (server-side only; NEVER use NEXT_PUBLIC_ prefix)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_SERVICE_ROLE_KEY=

# Meta / Facebook / Instagram OAuth (server-side only)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://YOUR_DOMAIN/api/growth/meta/callback
META_GRAPH_API_VERSION=
GROWTH_TOKEN_ENCRYPTION_KEY=

# WhatsApp Business Cloud API (server-side only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ORGANIZATION_ID=

# Vercel Cron protection (server-side only)
CRON_SECRET=
# Meta Webhooks (Facebook Lead Ads)
META_WEBHOOK_VERIFY_TOKEN=replace_with_a_random_secret
# Optional separate salt for privacy-preserving public endpoint rate-limit hashes
GROWTH_RATE_LIMIT_SALT=replace_with_a_random_secret
# Approximate USD/INR rate used only for AI usage estimates
USD_TO_INR_ESTIMATE=85
